{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run server (debug)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/index.js",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Run all tests (debug)",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--test", "tests/*.test.js"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
