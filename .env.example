# ============================================================================
# My workspace: settings
# Copy this file to ".env" (same folder) and fill in the values.
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
# NEVER commit ".env" to GitHub. It is already listed in .gitignore.
# ============================================================================

# ----- Server ---------------------------------------------------------------
PORT=3000
# 127.0.0.1 = only this computer can open it. Use 0.0.0.0 on a hosting service.
HOST=127.0.0.1
# "development" or "production". Production turns on Secure cookies and HSTS.
NODE_ENV=development
# The public address people will type, e.g. https://workspace.example.com
# (used for invite links and the Origin check). Leave blank when testing locally.
PUBLIC_URL=
# Set to true ONLY when running behind a trusted proxy/host (Render, Fly, Nginx, Cloudflare).
TRUST_PROXY=false

# ----- Data -----------------------------------------------------------------
# Folder for the SQLite database. On a host, point this at a PERSISTENT disk.
DATA_DIR=./data
# Daily automatic backup into DATA_DIR/backups (true/false) and how many to keep.
AUTO_BACKUP=true
BACKUP_KEEP=14

# ----- First admin ----------------------------------------------------------
# One-time setup code. Used ONCE on the sign-up page to create the first admin
# account, then it stops working. Make it long and random (at least 16 characters):
#   npm run gen:secret
ADMIN_SETUP_CODE=

# ----- Accounts and invites -------------------------------------------------
SESSION_DAYS=30
INVITE_DAYS=7
# How many workspaces one person may create.
MAX_WORKSPACES_PER_USER=3

# ----- AI assistant (choose one or several; none is required) ----------------
# Which provider is used when the person has not picked one in the menu:
# gemini | anthropic | openai | groq | openrouter | ollama
AI_PROVIDER=gemini

# Google Gemini. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude (paid). Key: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# OpenAI (paid)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Groq (has a free tier; OpenAI-compatible)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter (many models, some free; OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama: free AI that runs on your own computer. No key needed. https://ollama.com
# Turn it on by setting a model name you have downloaded, e.g. llama3.2
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Picture generation (Images page, "Make a picture") ---
# Uses the OpenAI or Gemini key above. Model names change often, so they are settings.
# OPENAI_IMAGE_MODEL=gpt-image-1
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Sign in with Google / GitHub (optional) ---
# Create a free OAuth app at each service. Set PUBLIC_URL above to your real address first.
# Redirect (callback) addresses to register:
#   Google : <PUBLIC_URL>/api/auth/oauth/google/callback
#   GitHub : <PUBLIC_URL>/api/auth/oauth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
